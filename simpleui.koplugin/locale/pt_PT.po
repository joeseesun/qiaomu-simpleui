#: modules/critter/reaction_lines.lua:287
msgid "%s already?"
msgstr "Já é %s?"

#: modules/critter/reaction_lines.lua:298
msgid "%s arrives! A new act begins!"
msgstr "Chegou %s! Começa um novo ato!"

#: modules/critter/reaction_lines.lua:66
msgid "%s is over. Good for you."
msgstr "%s acabou. Ainda bem para ti."

#: modules/critter/reaction_lines.lua:71
msgid "%s was a good one."
msgstr "%s foi dos bons."

#: modules/critter/reaction_lines.lua:75
msgid "%s will be sung about."
msgstr "Vão cantar %s por gerações."

#: modules/critter/reaction_lines.lua:67
msgid "%s! DONE! Incredible!"
msgstr "%s! Chegaste ao fim! Inacreditável!"

#: modules/critter/reaction_lines.lua:291
msgid "%s! New month, new adventures!"
msgstr "%s! Mês novo, aventuras novas!"

#: modules/critter/reaction_lines.lua:60
msgid "%s, finished!"
msgstr "Acabaste %s!"

#: modules/critter/reaction_lines.lua:290
msgid "%s. Another month of the same pile."
msgstr "%s. Mais um mês com a mesma pilha."

#: modules/critter/reaction_lines.lua:157
msgid "A MARATHON! You're unstoppable!"
msgstr "UMA MARATONA! És imparável!"

#: modules/critter/reaction_lines.lua:73
msgid "A book finished. I need to lie down."
msgstr "Um livro terminado. Preciso de me deitar."

#: modules/critter/reaction_lines.lua:88
msgid "A book is over. Good for you."
msgstr "Acabou um livro. Ainda bem para ti."

#: modules/critter/reaction_lines.lua:122
msgid "A brief, brilliant visit to another world!"
msgstr "Uma visita breve e brilhante a outro mundo!"

#: modules/critter/reaction_lines.lua:186
msgid "A charger would be lovely."
msgstr "Um carregador era capaz de cair bem."

#: modules/critter/reaction_lines.lua:252
msgid "A day for books, at last."
msgstr "Um dia para livros, finalmente."

#: modules/critter/reaction_lines.lua:142
msgid "A decent session. I almost stayed awake."
msgstr "Uma sessão decente. Quase não adormeci."

#: modules/critter/reaction_lines.lua:285
msgid "A fresh month, a fresh stack."
msgstr "Um mês novo, uma pilha nova."

#: modules/critter/reaction_lines.lua:156
msgid "A marathon. I'm tired just watching."
msgstr "Uma maratona. Só de ver já me cansei."

#: modules/critter/dialog.lua:160
msgid "A mind like an index. I'm honoured."
msgstr "Uma cabeça como um índice. É uma honra."

#: modules/critter/reaction_lines.lua:357
msgid "A month. I kept busy. Mostly sulking."
msgstr "Um mês. Fui-me entretendo. A amuar, sobretudo."

#: modules/critter/dialog.lua:373
msgid "A motion! Seconded by the entire shelf!"
msgstr "Uma moção! Apoiada pela prateleira inteira!"

#: modules/critter/reaction_lines.lua:74
msgid "A new chapter of your legend is complete!"
msgstr "Mais um capítulo da tua lenda está completo!"

#: modules/critter/reaction_lines.lua:235
msgid "A new year, a new saga! Onward!"
msgstr "Um ano novo, uma saga nova! Avante!"

#: modules/critter/reaction_lines.lua:234
msgid "A new year. Wake me in January. Oh, wait."
msgstr "Um ano novo. Acorda-me em janeiro. Ah, espera."

#: modules/critter/dialog.lua:271
msgid "A noble soul! Bards will sing of this."
msgstr "Uma alma nobre! Os bardos vão cantar isto."

#: modules/critter/reaction_lines.lua:125
msgid "A page here, a page there."
msgstr "Uma página aqui, outra ali."

#: modules/critter/reaction_lines.lua:130
msgid "A proper stretch."
msgstr "Uma boa sessão."

#: modules/critter/dialog.lua:270
msgid "A purist. Boring. Respect."
msgstr "Purismo. Aborrecido. Respeito."

#: modules/critter/dialog.lua:267
msgid "A purist. I knew I liked you."
msgstr "Purismo. Sabia que ia gostar de ti."

#: modules/critter/reaction_lines.lua:108
msgid "A quick peek?"
msgstr "Só uma espreitadela?"

#: modules/critter/reaction_lines.lua:143
msgid "A session worthy of the great libraries!"
msgstr "Uma sessão digna das grandes bibliotecas!"

#: modules/critter/reaction_lines.lua:319
msgid "A short holiday?"
msgstr "Umas férias curtas?"

#: modules/critter/reaction_lines.lua:121
msgid "A short one. My kind of effort."
msgstr "Curta. O meu tipo de esforço."

#: modules/critter/reaction_lines.lua:424
msgid "A small goal, a big grin."
msgstr "Um objetivo pequeno, um sorriso grande."

#: modules/critter/dialog.lua:213
msgid "A twist? In this economy?"
msgstr "Uma reviravolta? Com esta crise?"

#: modules/critter/dialog.lua:214
msgid "A whisper of a twist. Exquisite."
msgstr "Um sussurro de reviravolta. Requintado."

#: modules/critter/reaction_lines.lua:222
msgid "A whole year of unread pages awaits."
msgstr "Um ano inteiro de páginas por ler à espera."

#: modules/critter/dialog.lua:248
msgid "A word that earned its place on the shelf!"
msgstr "Uma palavra que mereceu o seu lugar na estante!"

#: modules/critter/dialog.lua:231
msgid "A word that tastes like old paper. Divine."
msgstr "Uma palavra com sabor a papel antigo. Divina."

#: modules/critter/dialog.lua:67
msgid "About what?"
msgstr "Sobre quê?"

#: modules/critter/reaction_lines.lua:163
msgid "All that reading. Wake me when it's over."
msgstr "Tanta leitura. Acorda-me quando acabar."

#: modules/critter/dialog.lua:281
msgid "Always."
msgstr "Sempre."

#: modules/critter/reaction_lines.lua:276
msgid "An anniversary. Cake? No? Nap, then."
msgstr "Um aniversário. Bolo? Não? Então, sesta."

#: modules/critter/reaction_lines.lua:269
msgid "An anniversary. I suppose I'm fond of you."
msgstr "Um aniversário. Acho que tenho carinho por ti."

#: modules/critter/dialog.lua:91
msgid "An audience! I knew this day would come."
msgstr "Público! Sabia que este dia ia chegar."

#: modules/critter/reaction_lines.lua:164
msgid "An epic voyage! The sagas will remember it!"
msgstr "Uma viagem épica! As sagas vão lembrar-se dela!"

#: modules/critter/reaction_lines.lua:70
msgid "Another book on the done pile."
msgstr "Mais um livro na pilha dos lidos."

#: modules/critter/reaction_lines.lua:96
msgid "Another chapter of your legend is complete!"
msgstr "Mais um capítulo da tua lenda está completo!"

#: modules/critter/reaction_lines.lua:280
msgid "Another lap around the sun."
msgstr "Mais uma volta ao Sol."

#: modules/critter/dialog.lua:701
msgid "Another one"
msgstr "Outro"

#: modules/critter/reaction_lines.lua:92
msgid "Another one for the done pile."
msgstr "Mais um para a pilha dos lidos."

#: modules/critter/reaction_lines.lua:227
msgid "Another year. The pile is still there."
msgstr "Mais um ano. A pilha continua lá."

#: modules/critter/dialog.lua:518
msgid "Asking for a friend. The friend is me."
msgstr "É para um amigo. O amigo sou eu."

#: modules/critter/dialog.lua:107
msgid "Aww! We'll cheer them up with a visit!"
msgstr "Ah! Vamos animá-los com uma visita!"

#: modules/critter/reaction_lines.lua:182
msgid "Battery low! Quick, adventure's calling!"
msgstr "Bateria fraca! Depressa, a aventura chama!"

#: modules/critter/dialog.lua:196
msgid "Be careful what you wish for."
msgstr "Cuidado com o que desejas."

#: modules/critter/dialog.lua:261
msgid "Be honest: do you read the last page first?"
msgstr "Diz a verdade: lês a última página primeiro?"

#: modules/critter/dialog.lua:323
msgid "Bold words, with no book in hand."
msgstr "Palavras ousadas, sem nenhum livro na mão."

#: modules/critter/dialog.lua:584
msgid "Bold. We'll see how long that lasts."
msgstr "Ousadia. Vamos ver quanto tempo dura."

#: modules/critter/reaction_lines.lua:255
msgid "Book Day. A holiday for my favourite thing: sitting."
msgstr "Dia do Livro. Um feriado para a minha coisa preferida: estar sentado."

#: modules/critter/reaction_lines.lua:82
msgid "Book finished!"
msgstr "Livro terminado!"

#: modules/critter/dialog.lua:113
msgid "Books don't have feelings."
msgstr "Os livros não têm sentimentos."

#: modules/critter/dialog.lua:478
msgid "Brave. I'd hide behind the sofa."
msgstr "Que coragem. Eu escondia-me atrás do sofá."

#: modules/critter/dialog.lua:480
msgid "Brave. I'm already behind the sofa."
msgstr "Que coragem. Eu já estou atrás do sofá."

#: modules/critter/module_critter.lua:799
msgid "Bubble style"
msgstr "Estilo do balão"

#: modules/critter/dialog.lua:120
msgid "Careful. They can hear you."
msgstr "Cuidado. Eles estão a ouvir-te."

#: modules/critter/dialog.lua:578
msgid "Challenge accepted"
msgstr "Desafio aceite"

#: modules/critter/reaction_lines.lua:411
msgid "Challenge crushed! Take a bow, champion!"
msgstr "Desafio esmagado! Faz uma vénia, campeão!"

#: modules/critter/reaction_lines.lua:407
msgid "Challenge met!"
msgstr "Desafio cumprido!"

#: modules/critter/dialog.lua:287
msgid "Chaos! I adore you."
msgstr "Caos! Adoro-te."

#: modules/critter/dialog.lua:436
msgid "Chapter one of a brand new saga!"
msgstr "Capítulo um de uma saga novinha em folha!"

#: modules/critter/dialog.lua:438
msgid "Chapter one. Again. Wonderful."
msgstr "Capítulo um. Outra vez. Maravilhoso."

#: modules/critter/reaction_lines.lua:202
msgid "Charging. About time."
msgstr "A carregar. Já não era sem tempo."

#: modules/critter/reaction_lines.lua:199
msgid "Charging. Bliss."
msgstr "A carregar. Que bem."

#: modules/critter/reaction_lines.lua:209
msgid "Charging. Wake me at 100%."
msgstr "A carregar. Acorda-me nos 100%."

#: modules/critter/dialog.lua:188
msgid "Confetti! Dragons! A talking bookcase!"
msgstr "Confetis! Dragões! Uma estante que fala!"

#: modules/critter/dialog.lua:417
msgid "Counting is my love language."
msgstr "Contar é a minha linguagem do amor."

#: modules/critter/reaction_lines.lua:89
msgid "DONE! Incredible!"
msgstr "ACABADO! Inacreditável!"

#: modules/critter/dialog.lua:63
msgid "Dangerous AND brilliant. Naturally."
msgstr "Perigoso E brilhante. Naturalmente."

#: modules/critter/dialog.lua:61
msgid "Dangerous! Thrilling! Say it again!"
msgstr "Perigoso! Emocionante! Diz outra vez!"

#: modules/critter/dialog.lua:56
msgid "Dangerous."
msgstr "Perigoso."

#: modules/critter/dialog.lua:211
msgid "Deal. A twist so quiet nobody notices."
msgstr "Combinado. Uma reviravolta tão discreta que ninguém repara."

#: modules/critter/dialog.lua:517
msgid "Do the unread books judge us?"
msgstr "Os livros por ler julgam-nos?"

#: modules/critter/dialog.lua:520
msgid "Do the unread books judge us? I think so."
msgstr "Os livros por ler julgam-nos? Acho que sim."

#: modules/critter/dialog.lua:98
msgid "Do you think books get lonely?"
msgstr "Achas que os livros se sentem sozinhos?"

#: modules/critter/dialog.lua:170
msgid "Dog-ears are better."
msgstr "Orelhas nas páginas são melhores."

#: modules/critter/dialog.lua:71
msgid "Don't answer. It's a trap."
msgstr "Não respondas. É uma armadilha."

#: modules/critter/dialog.lua:459
msgid "Don't remind me."
msgstr "Não me lembres."

#: modules/critter/reaction_lines.lua:421
msgid "Done and dusted! Look at you go!"
msgstr "Feito e arrumado! Olha para ti!"

#: modules/critter/reaction_lines.lua:417
msgid "Done and dusted."
msgstr "Feito e arrumado."

#: modules/critter/reaction_lines.lua:420
msgid "Done. Now I need a nap."
msgstr "Feito. Agora preciso de uma sesta."

#: modules/critter/reaction_lines.lua:151
msgid "Drink some water, hero."
msgstr "Bebe água, herói."

#: modules/critter/reaction_lines.lua:214
msgid "Electrons, my favourite."
msgstr "Eletrões, os meus preferidos."

#: modules/critter/reaction_lines.lua:210
msgid "Energy flows! I am reborn!"
msgstr "A energia flui! Renasci!"

#: modules/critter/reaction_lines.lua:112
msgid "Even a few pages count."
msgstr "Até umas poucas páginas contam."

#: modules/critter/dialog.lua:350
msgid "Every day is a reading day."
msgstr "Todos os dias são dias de leitura."

#: modules/critter/dialog.lua:355
msgid "Every day! Hooray!"
msgstr "Todos os dias! Viva!"

#: modules/critter/reaction_lines.lua:115
msgid "Every page counts! Hooray for pages!"
msgstr "Todas as páginas contam! Viva as páginas!"

#: modules/critter/dialog.lua:562
msgid "Every single book opened! Look at you!"
msgstr "Todos os livros abertos! Olha para ti!"

#: modules/critter/dialog.lua:205
msgid "Everyone's fine. The tea isn't."
msgstr "Está tudo bem. O chá é que não."

#: modules/critter/dialog.lua:294
msgid "Exactly the energy I need."
msgstr "Exatamente a energia de que preciso."

#: modules/critter/dialog.lua:227
msgid "Fancy. Very fancy."
msgstr "Chique. Muito chique."

#: modules/critter/reaction_lines.lua:185
msgid "Feeling a bit faint."
msgstr "Ando com pouca energia."

#: modules/critter/dialog.lua:88
msgid "Finally, an audience."
msgstr "Finalmente, público."

#: modules/critter/dialog.lua:148
msgid "Finders keepers."
msgstr "Achado não é roubado."

#: modules/critter/dialog.lua:145
msgid "Finders keepers. Kidding. Mostly."
msgstr "Achado não é roubado. Brincadeira. Quase."

#: modules/critter/reaction_lines.lua:135
msgid "Fine. A decent session. Don't let it go to your head."
msgstr "Pronto. Uma sessão decente. Não te subas à cabeça."

#: modules/critter/dialog.lua:399
msgid "Fine. But I'm not wearing a party hat."
msgstr "Pronto. Mas não ponho chapéu de festa."

#: modules/critter/dialog.lua:167
msgid "Fine. But it's looking at me."
msgstr "Pronto. Mas está a olhar para mim."

#: modules/critter/dialog.lua:341
msgid "Fine. I'll go be dramatic elsewhere."
msgstr "Pronto. Vou fazer drama noutro sítio."

#: modules/critter/dialog.lua:43
msgid "Fine. The books can wait. So can I."
msgstr "Pronto. Os livros esperam. Eu também."

#: modules/critter/dialog.lua:41
msgid "Fine. They'll keep."
msgstr "Pronto. Ficam à espera."

#: modules/critter/reaction_lines.lua:410
msgid "Fine. You did it. Don't expect a parade."
msgstr "Pronto. Conseguiste. Não esperes um desfile."

#: modules/critter/dialog.lua:192
msgid "Gasp."
msgstr "Ai."

#: modules/critter/dialog.lua:278
msgid "Gasp. Your secret is safe with the shelves."
msgstr "Ai. O teu segredo está seguro com as estantes."

#: modules/critter/dialog.lua:105
msgid "Go and visit one."
msgstr "Vai visitar um."

#: modules/critter/dialog.lua:85
msgid "Go on, I'm listening."
msgstr "Diz lá, estou a ouvir."

#: modules/critter/reaction_lines.lua:260
msgid "Go on, pick something shiny."
msgstr "Anda, escolhe algo brilhante."

#: modules/critter/dialog.lua:608
msgid "Go, go, go! Pages await."
msgstr "Vai, vai, vai! As páginas esperam."

#: modules/critter/dialog.lua:498
msgid "Goals are patient. Until they aren't."
msgstr "Os objetivos são pacientes. Até deixarem de ser."

#: modules/critter/dialog.lua:108
msgid "Great. Now I'm thinking about it."
msgstr "Ótimo. Agora estou a pensar nisso."

#: modules/critter/reaction_lines.lua:270
msgid "HAPPY ANNIVERSARY! I love us!"
msgstr "FELIZ ANIVERSÁRIO! Adoro-nos!"

#: modules/critter/reaction_lines.lua:228
msgid "HAPPY NEW YEAR! Let's read everything!"
msgstr "FELIZ ANO NOVO! Vamos ler tudo!"

#: modules/critter/dialog.lua:347
msgid "Happy %s, I suppose?"
msgstr "Um bom dia de %s, suponho?"

#: modules/critter/reaction_lines.lua:259
msgid "Happy Book Day!"
msgstr "Feliz Dia do Livro!"

#: modules/critter/reaction_lines.lua:242
msgid "Happy World Book Day!"
msgstr "Feliz Dia Mundial do Livro!"

#: modules/critter/reaction_lines.lua:266
msgid "Happy anniversary!"
msgstr "Feliz aniversário!"

#: modules/critter/reaction_lines.lua:221
msgid "Happy new year!"
msgstr "Feliz ano novo!"

#: modules/critter/dialog.lua:353
msgid "Hear, hear! Put it on a mug."
msgstr "Muito bem! Põe isso numa caneca."

#: modules/critter/dialog.lua:173
msgid "Heresy! Call the librarian."
msgstr "Heresia! Chamem o bibliotecário."

#: modules/critter/reaction_lines.lua:320
msgid "Hope the books were jealous."
msgstr "Espero que os livros tenham tido ciúmes."

#: modules/critter/reaction_lines.lua:193
msgid "I didn't want to say anything."
msgstr "Não queria dizer nada."

#: modules/critter/dialog.lua:252
msgid "I don't have one."
msgstr "Não tenho nenhum."

#: modules/critter/reaction_lines.lua:334
msgid "I dusted the shelves twice."
msgstr "Limpei o pó das estantes duas vezes."

#: modules/critter/dialog.lua:139
msgid "I found a bookmark in the sofa."
msgstr "Encontrei um marcador no sofá."

#: modules/critter/reaction_lines.lua:312
msgid "I kept your place."
msgstr "Guardei-te o lugar."

#: modules/critter/dialog.lua:586
msgid "I knew you'd say yes. I love this for us."
msgstr "Sabia que ias dizer que sim. Adoro isto para nós."

#: modules/critter/reaction_lines.lua:355
#: modules/critter/reaction_lines.lua:408
msgid "I never doubted you. Much."
msgstr "Nunca duvidei de ti. Muito."

#: modules/critter/dialog.lua:130
msgid "I never thought about it."
msgstr "Nunca pensei nisso."

#: modules/critter/dialog.lua:333
msgid "I preside over a kingdom of paper."
msgstr "Governo um reino de papel."

#: modules/critter/reaction_lines.lua:273
msgid "I remember the day we met."
msgstr "Lembro-me do dia em que nos conhecemos."

#: modules/critter/reaction_lines.lua:347
msgid "I started talking to the bookcase."
msgstr "Comecei a falar com a estante."

#: modules/critter/dialog.lua:329
msgid "I supervise the shelves."
msgstr "Eu supervisiono as estantes."

#: modules/critter/dialog.lua:332
msgid "I supervise the shelves. Sitting down."
msgstr "Eu supervisiono as estantes. Daqui de baixo."

#: modules/critter/dialog.lua:179
msgid "I'd like a plot twist today."
msgstr "Hoje apetecia-me uma reviravolta."

#: modules/critter/dialog.lua:377
msgid "I'd rather not discuss it."
msgstr "Prefiro não falar disso."

#: modules/critter/dialog.lua:453
msgid "I'll be back, promise."
msgstr "Volto já, prometo."

#: modules/critter/dialog.lua:456
msgid "I'll hold you to it. Gently. With snacks."
msgstr "Vou cobrar-te isso. Com jeitinho. E com snacks."

#: modules/critter/reaction_lines.lua:200
msgid "I'll just rest my eyes."
msgstr "Vou só descansar os olhos."

#: modules/critter/reaction_lines.lua:175
msgid "I'm at %d%%."
msgstr "Estou nos %d%%."

#: modules/critter/reaction_lines.lua:425
msgid "I'm keeping count, you know."
msgstr "Estou a contar, sabes?"

#: modules/critter/reaction_lines.lua:64
#: modules/critter/reaction_lines.lua:86
msgid "I'm not crying. It's dust."
msgstr "Não estou a chorar. É pó."

#: modules/critter/dialog.lua:485
msgid "I'm on track."
msgstr "Vou no bom caminho."

#: modules/critter/dialog.lua:53
msgid "I've been thinking."
msgstr "Tenho andado a pensar."

#: modules/critter/reaction_lines.lua:253
msgid "I've been waiting all year."
msgstr "Esperei o ano inteiro por isto."

#: modules/critter/dialog.lua:159
msgid "Impressive. I'd clap, but effort."
msgstr "Impressionante. Aplaudia, mas dá trabalho."

#: modules/critter/dialog.lua:559
msgid "Impressive. Or suspicious."
msgstr "Impressionante. Ou suspeito."

#: modules/critter/dialog.lua:156
msgid "Impressive. Terrifying, but impressive."
msgstr "Impressionante. Assustador, mas impressionante."

#: modules/critter/dialog.lua:244
msgid "Invented by a publisher, loved by everyone."
msgstr "Inventado por um editor, adorado por todos."

#: modules/critter/dialog.lua:303
msgid "Is it already nap o'clock?"
msgstr "Já é hora da sesta?"

#: modules/critter/dialog.lua:361
msgid "Is it already?"
msgstr "Já?"

#: modules/critter/dialog.lua:302
msgid "Is it morning already?"
msgstr "Já é de manhã?"

#: modules/critter/reaction_lines.lua:97
msgid "It will be sung about."
msgstr "Vão cantar isto por gerações."

#: modules/critter/reaction_lines.lua:297
msgid "It's %s. I barely noticed."
msgstr "Estamos em %s. Mal reparei."

#: modules/critter/reaction_lines.lua:245
msgid "It's World Book Day!"
msgstr "É o Dia Mundial do Livro!"

#: modules/critter/reaction_lines.lua:348
msgid "It's a good listener."
msgstr "Ouve muito bem."

#: modules/critter/dialog.lua:540
msgid "It's always about snacks, %s."
msgstr "É sempre por causa dos snacks, %s."

#: modules/critter/dialog.lua:542
msgid "It's always about snacks, %s. And naps."
msgstr "É sempre por causa dos snacks, %s. E das sestas."

#: modules/critter/reaction_lines.lua:333
msgid "It's been a while."
msgstr "Já foi há algum tempo."

#: modules/critter/reaction_lines.lua:361
msgid "It's been so long."
msgstr "Já passou tanto tempo."

#: modules/critter/dialog.lua:443
msgid "It's on holiday."
msgstr "Está de férias."

#: modules/critter/reaction_lines.lua:118
msgid "Just a little one today."
msgstr "Só uma pequenina hoje."

#: modules/critter/dialog.lua:582
msgid "Kindly. Mostly kindly."
msgstr "Com carinho. Quase sempre com carinho."

#: modules/critter/dialog.lua:338
msgid "Leave me be."
msgstr "Deixa-me em paz."

#: modules/critter/dialog.lua:610
msgid "Less talking. More reading."
msgstr "Menos conversa. Mais leitura."

#: modules/critter/dialog.lua:481
msgid "Let it watch! We shall dazzle it!"
msgstr "Que veja! Vamos deslumbrá-lo!"

#: modules/critter/dialog.lua:475
msgid "Let it watch."
msgstr "Que veja."

#: modules/critter/dialog.lua:393
msgid "Let's keep it going."
msgstr "Vamos manter o ritmo."

#: modules/critter/reaction_lines.lua:239
msgid "Let's make it a good chapter."
msgstr "Vamos fazer dele um bom capítulo."

#: modules/critter/dialog.lua:433
msgid "Let's restart it today."
msgstr "Vamos recomeçar hoje."

#: modules/critter/reaction_lines.lua:295
msgid "Let's see what %s brings."
msgstr "Vamos ver o que %s traz."

#: modules/critter/dialog.lua:182
msgid "Like what?"
msgstr "Como o quê?"

#: modules/critter/reaction_lines.lua:119
msgid "Little reads add up."
msgstr "As leituras pequeninas somam."

#: modules/critter/reaction_lines.lua:264
msgid "Look at us."
msgstr "Olha para nós."

#: modules/critter/reaction_lines.lua:309
msgid "Look who's back!"
msgstr "Olha quem voltou!"

#: modules/critter/reaction_lines.lua:139
msgid "Look who's got staying power."
msgstr "Olha só quem tem resistência."

#: modules/critter/reaction_lines.lua:188
msgid "Low battery. Finally, a reason to nap."
msgstr "Bateria fraca. Finalmente, uma desculpa para dormir."

#: modules/critter/reaction_lines.lua:181
msgid "Low battery. Typical."
msgstr "Bateria fraca. Típico."

#: modules/critter/dialog.lua:448
msgid "Lucky streak. I could use a holiday."
msgstr "Que sorte. Eu também precisava de férias."

#: modules/critter/dialog.lua:208
msgid "Make it a quiet one."
msgstr "Que seja um dia sossegado."

#: modules/critter/reaction_lines.lua:153
msgid "Marathon reader!"
msgstr "Leitura de maratona!"

#: modules/critter/dialog.lua:590
msgid "Maybe later"
msgstr "Talvez mais tarde"

#: modules/critter/dialog.lua:124
msgid "Mine are perfectly happy."
msgstr "As minhas estão muito contentes."

#: modules/critter/reaction_lines.lua:232
msgid "Mine is to nap more. Yours?"
msgstr "O meu é dormir mais sestas. E o teu?"

#: modules/critter/dialog.lua:286
msgid "Monstrous. And yet, efficient."
msgstr "Monstruoso. E, no entanto, eficiente."

#: modules/critter/dialog.lua:284
msgid "Monstrous. I'll allow it."
msgstr "Monstruoso. Permito."

#: modules/critter/reaction_lines.lua:189
msgid "My light is fading! Fetch the charger, brave soul!"
msgstr "A minha luz está a apagar-se! Traz o carregador, alma corajosa!"

#: modules/critter/dialog.lua:235
msgid "Nap."
msgstr "Dormir."

#: modules/critter/dialog.lua:462
msgid "Never mentioned. Never existed."
msgstr "Nunca falámos nisso. Nunca existiu."

#: modules/critter/dialog.lua:264
msgid "Never!"
msgstr "Nunca!"

#: modules/critter/reaction_lines.lua:301
msgid "New month, new goals."
msgstr "Mês novo, objetivos novos."

#: modules/critter/reaction_lines.lua:224
msgid "New year, new shelf."
msgstr "Ano novo, estante nova."

#: modules/critter/reaction_lines.lua:132
msgid "Nice little session!"
msgstr "Boa sessãozinha!"

#: modules/critter/dialog.lua:404
msgid "No pressure? Sure."
msgstr "Sem pressão? Claro."

#: modules/critter/dialog.lua:44
msgid "No rush! The shelf isn't going anywhere."
msgstr "Sem pressa! A estante não vai a lado nenhum."

#: modules/critter/dialog.lua:424
msgid "No shame in snacks."
msgstr "Não há vergonha nos snacks."

#: modules/critter/reaction_lines.lua:101
msgid "No spoilers. Okay, spoilers."
msgstr "Sem spoilers. Pronto, com spoilers."

#: modules/critter/dialog.lua:567
#: modules/critter/dialog.lua:702
msgid "Not now"
msgstr "Agora não"

#: modules/critter/dialog.lua:79
msgid "Not now."
msgstr "Agora não."

#: modules/critter/dialog.lua:561
msgid "Not one unopened book. Show-off."
msgstr "Nem um livro por abrir. Exibido."

#: modules/critter/dialog.lua:320
msgid "Not really."
msgstr "Não propriamente."

#: modules/critter/reaction_lines.lua:176
msgid "Not to be dramatic, but find a charger."
msgstr "Sem querer fazer drama, mas arranja um carregador."

#: modules/critter/dialog.lua:82
msgid "Noted. I'll sulk quietly. Loudly."
msgstr "Anotado. Vou amuar em silêncio. Bem alto."

#: modules/critter/dialog.lua:558
msgid "Nothing unopened on your shelves."
msgstr "Não há nada por abrir nas tuas estantes."

#: modules/critter/dialog.lua:189
msgid "Nothing. Nothing happens. Perfect."
msgstr "Nada. Não acontece nada. Perfeito."

#: modules/critter/dialog.lua:133
msgid "Now you never will stop."
msgstr "Agora é que nunca mais paras."

#: modules/critter/dialog.lua:186
msgid "Obviously."
msgstr "Obviamente."

#: modules/critter/dialog.lua:596
msgid "Of course. No pressure at all."
msgstr "Claro. Sem pressão nenhuma."

#: modules/critter/dialog.lua:73
msgid "Oh, EVERYTHING! Where do I even start?"
msgstr "Ah, TUDO! Por onde é que começo?"

#: modules/critter/reaction_lines.lua:315
msgid "Oh, you remember me."
msgstr "Ah, lembraste-te de mim."

#: modules/critter/dialog.lua:605
msgid "On it!"
msgstr "Já estou nisso!"

#: modules/critter/dialog.lua:491
msgid "On track and in legend. Metaphorically."
msgstr "No bom caminho e a caminho da lenda. Metaforicamente."

#: modules/critter/dialog.lua:488
msgid "On track and on fire. Metaphorically."
msgstr "No bom caminho e em chamas. Metaforicamente."

#: modules/critter/dialog.lua:490
msgid "On track. I'm proud, quietly."
msgstr "No bom caminho. Tenho orgulho, em silêncio."

#: modules/critter/reaction_lines.lua:95
msgid "One more finished. I need to lie down."
msgstr "Mais um terminado. Preciso de me deitar."

#: modules/critter/dialog.lua:537
msgid "Only if it's about snacks."
msgstr "Só se for sobre snacks."

#: modules/critter/dialog.lua:101
msgid "Only the unread ones."
msgstr "Só os que ainda não li."

#: modules/critter/dialog.lua:400
msgid "Onward! Glory awaits in chapter nine!"
msgstr "Avante! A glória espera no capítulo nove!"

#: modules/critter/dialog.lua:229
msgid "Ooh, so pretty! Say it again!"
msgstr "Ui, tão bonito! Diz outra vez!"

#: modules/critter/reaction_lines.lua:196
msgid "Ooh, that's nice."
msgstr "Ui, que bom."

#: modules/critter/dialog.lua:504
msgid "Ooh. A question for a committee of me."
msgstr "Ui. Uma pergunta para uma comissão de mim próprio."

#: modules/critter/dialog.lua:700
msgid "Open it"
msgstr "Abrir"

#: modules/critter/reaction_lines.lua:302
msgid "Or the same ones. I'm not picky."
msgstr "Ou os mesmos. Eu não me importo."

#: modules/critter/reaction_lines.lua:277
msgid "Our story is the finest of all libraries!"
msgstr "A nossa história é a melhor de todas as bibliotecas!"

#: modules/critter/dialog.lua:153
msgid "Page 212, probably."
msgstr "Página 212, provavelmente."

#: modules/critter/dialog.lua:190
msgid "Peace at last."
msgstr "Paz, finalmente."

#: modules/critter/module_critter.lua:801
msgid "Pixel"
msgstr "Pixel"

#: modules/critter/dialog.lua:531
msgid "Please don't."
msgstr "Por favor, não."

#: modules/critter/dialog.lua:446
msgid "Postcards expected."
msgstr "Esperam-se postais."

#: modules/critter/reaction_lines.lua:203
msgid "Power! Glorious power!"
msgstr "Energia! Gloriosa energia!"

#: modules/critter/dialog.lua:511
msgid "Psst, %s. Can I ask you something?"
msgstr "Psst, %s. Posso perguntar-te uma coisa?"

#: modules/critter/reaction_lines.lua:192
msgid "Psst. The battery is low."
msgstr "Psst. A bateria está fraca."

#: modules/critter/dialog.lua:164
msgid "Put it back."
msgstr "Põe de volta."

#: modules/critter/dialog.lua:357
msgid "Put it on a banner. On a flag!"
msgstr "Põe isso num estandarte. Numa bandeira!"

#: modules/critter/dialog.lua:356
msgid "Put it on a mug. Then leave me alone."
msgstr "Põe isso numa caneca. E depois deixa-me em paz."

#: modules/critter/dialog.lua:370
msgid "Put it to a vote. I'm in favour."
msgstr "Vai a votos. Eu sou a favor."

#: modules/critter/dialog.lua:372
msgid "Put it to a vote. Tomorrow."
msgstr "Vai a votos. Amanhã."

#: modules/critter/dialog.lua:221
msgid "Quick: favourite word?"
msgstr "Depressa: palavra preferida?"

#: modules/critter/module_critter.lua:851
msgid "React to events"
msgstr "Reagir a acontecimentos"

#: modules/critter/challenge.lua:219
msgid "Read a little today and your streak is safe."
msgstr "Lê um pouco hoje e a tua sequência fica a salvo."

#: modules/critter/challenge.lua:205
msgid "Read a little today to keep your streak?"
msgstr "Ler um pouco hoje para manter a tua sequência?"

#: modules/critter/challenge.lua:207
msgid "Read before %d:00?"
msgstr "Ler antes das %d:00?"

#: modules/critter/reaction_lines.lua:246
msgid "Reading today is practically mandatory."
msgstr "Hoje, ler é praticamente obrigatório."

#: modules/critter/reaction_lines.lua:231
msgid "Resolutions?"
msgstr "Resoluções?"

#: modules/critter/dialog.lua:149
msgid "Returned with full honours!"
msgstr "Devolvido com todas as honras!"

#: modules/critter/reaction_lines.lua:313
msgid "Right where you left it."
msgstr "Exatamente onde o deixaste."

#: modules/critter/dialog.lua:59
msgid "Rude. Accurate, but rude."
msgstr "Mal-educado. Certeiro, mas mal-educado."

#: modules/critter/dialog.lua:62
msgid "Rude. Also correct. I hate that."
msgstr "Mal-educado. E também certo. Odeio isso."

#: modules/critter/reaction_lines.lua:178
msgid "Running on fumes."
msgstr "A andar a vapores."

#: modules/critter/reaction_lines.lua:140
msgid "Same time tomorrow?"
msgstr "Amanhã à mesma hora?"

#: modules/critter/talk.lua:112
msgid "Say something else…"
msgstr "Diz outra coisa…"

#: modules/critter/dialog.lua:119
msgid "Says the one who needs a charger."
msgstr "Diz quem precisa de um carregador."

#: modules/critter/dialog.lua:224
msgid "Serendipity."
msgstr "Serendipidade."

#: modules/critter/reaction_lines.lua:418
msgid "Shall I pick a harder one tomorrow?"
msgstr "Escolho um mais difícil amanhã?"

#: modules/critter/reaction_lines.lua:369
msgid "Shall we pick up where we left off?"
msgstr "Retomamos onde ficámos?"

#: modules/critter/dialog.lua:521
msgid "Shall we read them all and settle it?"
msgstr "Lemo-los todos e tiramos isto a limpo?"

#: modules/critter/reaction_lines.lua:111
msgid "Short and sweet."
msgstr "Curto e bom."

#: modules/critter/dialog.lua:305
msgid "Shouldn't we both be asleep?"
msgstr "Não devíamos estar ambos a dormir?"

#: modules/critter/dialog.lua:230
msgid "Show-off."
msgstr "Exibido."

#: modules/critter/reaction_lines.lua:197
msgid "Slurp. Thank you."
msgstr "Slurp. Que bom."

#: modules/critter/dialog.lua:618
msgid "Small steps. One page is still a page."
msgstr "Passos pequenos. Uma página continua a ser uma página."

#: modules/critter/module_critter.lua:802
msgid "Smooth"
msgstr "Suave"

#: modules/critter/reaction_lines.lua:213
msgid "Snack time!"
msgstr "Hora do snack!"

#: modules/critter/reaction_lines.lua:336
msgid "So you remember where I live."
msgstr "Então ainda sabes onde eu moro."

#: modules/critter/reaction_lines.lua:78
#: modules/critter/reaction_lines.lua:100
msgid "So, how did it end?"
msgstr "Então, como acabou?"

#: modules/critter/dialog.lua:275
msgid "Sometimes."
msgstr "Às vezes."

#: modules/critter/dialog.lua:199
msgid "Sound advice. I'll ignore it."
msgstr "Bom conselho. Vou ignorá-lo."

#: modules/critter/dialog.lua:127
msgid "Spoiled books. I approve."
msgstr "Livros estragados com spoilers. Aprovo."

#: modules/critter/dialog.lua:202
msgid "Spoilers, please."
msgstr "Spoilers, por favor."

#: modules/critter/dialog.lua:528
msgid "Spoken like a true diplomat, %s."
msgstr "Falou a diplomacia em pessoa, %s."

#: modules/critter/challenge.lua:221
msgid "Start reading before %d:00 and it's yours."
msgstr "Começa a ler antes das %d:00 e o desafio é teu."

#: modules/critter/dialog.lua:414
msgid "Stop counting."
msgstr "Pára de contar."

#: modules/critter/dialog.lua:449
msgid "Sunburnt and ready to return, I hope!"
msgstr "Com cor de praia e vontade de voltar, espero!"

#: modules/critter/dialog.lua:514
msgid "Sure."
msgstr "Claro."

#: modules/critter/reaction_lines.lua:61
#: modules/critter/reaction_lines.lua:83
msgid "Take a bow. I'll hold the applause."
msgstr "Faz uma vénia. Eu guardo os aplausos."

#: modules/critter/dialog.lua:334
msgid "Taxes are low."
msgstr "Os impostos estão baixos."

#: modules/critter/reaction_lines.lua:79
msgid "Tell me about %s. No spoilers. Okay, spoilers."
msgstr "Fala-me de %s. Sem spoilers. Pronto, com spoilers."

#: modules/critter/reaction_lines.lua:341
msgid "Tell me everything. Slowly."
msgstr "Conta-me tudo. Devagar."

#: modules/critter/dialog.lua:116
msgid "Tell that to the ending of that one book."
msgstr "Diz isso ao final daquele livro."

#: modules/critter/dialog.lua:525
msgid "That depends."
msgstr "Depende."

#: modules/critter/reaction_lines.lua:93
msgid "That was a good one."
msgstr "Foi das boas."

#: modules/critter/reaction_lines.lua:146
msgid "That was cosy."
msgstr "Foi acolhedor."

#: modules/critter/reaction_lines.lua:114
msgid "That was short. I blinked and missed it."
msgstr "Foi curto. Pisquei os olhos e perdi."

#: modules/critter/reaction_lines.lua:126
msgid "That's how libraries get built."
msgstr "É assim que se constroem as bibliotecas."

#: modules/critter/dialog.lua:142
msgid "That's mine!"
msgstr "É meu!"

#: modules/critter/reaction_lines.lua:415
msgid "That's the best kind of promise."
msgstr "É a melhor espécie de promessa."

#: modules/critter/dialog.lua:104
msgid "That's the saddest true thing I've heard."
msgstr "É a coisa mais triste e verdadeira que ouvi."

#: modules/critter/dialog.lua:396
msgid "That's the spirit! I'll sharpen the bookmarks."
msgstr "É esse o espírito! Vou afiar os marcadores."

#: modules/critter/dialog.lua:581
msgid "That's the spirit. I'll be watching."
msgstr "É esse o espírito. Estarei a ver."

#: modules/critter/reaction_lines.lua:147
msgid "The book and you make a good team."
msgstr "O livro e tu fazem uma boa equipa."

#: modules/critter/reaction_lines.lua:161
msgid "The book clearly deserved it."
msgstr "O livro merecia, claramente."

#: modules/critter/reaction_lines.lua:133
msgid "The book is warm now."
msgstr "O livro já está quentinho."

#: modules/critter/reaction_lines.lua:331
msgid "The books were worried."
msgstr "Os livros estavam preocupados."

#: modules/critter/dialog.lua:185
msgid "The butler did it. In a library. With a bookmark."
msgstr "Foi o mordomo. Na biblioteca. Com um marcador."

#: modules/critter/reaction_lines.lua:294
msgid "The calendar flipped a page."
msgstr "O calendário virou a página."

#: modules/critter/dialog.lua:191
msgid "The critter was the author all along!"
msgstr "A mascote era a autora desde o início!"

#: modules/critter/reaction_lines.lua:362
msgid "The dust and I have become friends."
msgstr "O pó e eu ficámos amigos."

#: modules/critter/dialog.lua:495
msgid "The goal can wait."
msgstr "O objetivo pode esperar."

#: modules/critter/reaction_lines.lua:365
msgid "The hero returns after a long quest!"
msgstr "O herói regressa de uma longa demanda!"

#: modules/critter/dialog.lua:304
msgid "The light is nice this time of day."
msgstr "A luz está agradável a esta hora do dia."

#: modules/critter/dialog.lua:593
msgid "The offer stands. Dramatically."
msgstr "A oferta mantém-se. Dramaticamente."

#: modules/critter/reaction_lines.lua:344
msgid "The reader returns! Let the feast begin!"
msgstr "A leitura regressa! Que comece o banquete!"

#: modules/critter/dialog.lua:439
msgid "The sequel will be better. I can feel it!"
msgstr "A sequela vai ser melhor. Sinto-o!"

#: modules/critter/reaction_lines.lua:327
msgid "The shelves missed you."
msgstr "As estantes tiveram saudades tuas."

#: modules/critter/dialog.lua:430
msgid "The streak took a little break."
msgstr "A sequência fez uma pequena pausa."

#: modules/critter/reaction_lines.lua:323
msgid "The wanderer returns to the library!"
msgstr "Regressa à biblioteca quem andava ausente!"

#: modules/critter/reaction_lines.lua:160
msgid "The world can wait."
msgstr "O mundo pode esperar."

#: modules/critter/reaction_lines.lua:238
msgid "The year turns like a page."
msgstr "O ano vira como uma página."

#: modules/critter/dialog.lua:255
msgid "Then borrow mine: snack."
msgstr "Então pede o meu emprestado: snack."

#: modules/critter/dialog.lua:621
msgid "Then let's take it slowly. Very slowly."
msgstr "Então vamos com calma. Com muita calma."

#: modules/critter/dialog.lua:312
msgid "Then we agree. A rare event."
msgstr "Então estamos de acordo. Um acontecimento raro."

#: modules/critter/dialog.lua:109
msgid "Then we rescue them, one chapter at a time!"
msgstr "Então resgatamo-los, um capítulo de cada vez!"

#: modules/critter/dialog.lua:423
msgid "Then we start again, with snacks."
msgstr "Então recomeçamos, com snacks."

#: modules/critter/reaction_lines.lua:288
msgid "Time flies when you're reading."
msgstr "O tempo voa quando se lê."

#: modules/critter/dialog.lua:364
msgid "Time is an illusion. So are weekends."
msgstr "O tempo é uma ilusão. Os fins de semana também."

#: modules/critter/reaction_lines.lua:256
msgid "Today the whole world kneels to the book!"
msgstr "Hoje o mundo inteiro se ajoelha perante o livro!"

#: modules/critter/reaction_lines.lua:243
msgid "Today we celebrate you and your shelves."
msgstr "Hoje celebramos-te a ti e às tuas estantes."

#: modules/critter/reaction_lines.lua:281
msgid "Together, with books."
msgstr "Juntos, com livros."

#: modules/critter/dialog.lua:534
msgid "Too late. It's already in the air."
msgstr "Tarde demais. Já está no ar."

#: modules/critter/dialog.lua:615
msgid "Tough one…"
msgstr "Está difícil…"

#: modules/critter/dialog.lua:696
msgid "Try “%s”, by %s."
msgstr "Experimenta «%s», de %s."

#: modules/critter/dialog.lua:697
msgid "Try “%s”."
msgstr "Experimenta «%s»."

#: modules/critter/dialog.lua:595
msgid "Typical."
msgstr "Típico."

#: modules/critter/dialog.lua:380
msgid "Understood. Let us speak of the weather. Damp."
msgstr "Percebido. Falemos do tempo. Húmido."

#: modules/critter/dialog.lua:241
msgid "Unputdownable."
msgstr "Impossível de pousar."

#: modules/critter/dialog.lua:247
msgid "Unputdownable. Unlike my energy levels."
msgstr "Impossível de pousar. Ao contrário da minha energia."

#: modules/critter/dialog.lua:611
msgid "Unstoppable! I can feel it!"
msgstr "Imparável! Dá para sentir!"

#: modules/critter/dialog.lua:330
msgid "Very demanding work."
msgstr "Trabalho muito exigente."

#: modules/critter/dialog.lua:309
msgid "Very much."
msgstr "Muitíssimo."

#: modules/critter/reaction_lines.lua:249
msgid "WORLD BOOK DAY! The best day of the year!"
msgstr "DIA MUNDIAL DO LIVRO! O melhor dia do ano!"

#: modules/critter/dialog.lua:552
msgid "Want something new to read?"
msgstr "Queres ler algo novo?"

#: modules/critter/reaction_lines.lua:167
msgid "Was it that good?"
msgstr "Foi assim tão bom?"

#: modules/critter/dialog.lua:316
msgid "We agree! Fetch the confetti!"
msgstr "Estamos de acordo! Tragam os confetis!"

#: modules/critter/dialog.lua:315
msgid "We agree. Mark the calendar."
msgstr "Estamos de acordo. Marca no calendário."

#: modules/critter/dialog.lua:367
msgid "Weekdays should be optional."
msgstr "Os dias úteis deviam ser opcionais."

#: modules/critter/reaction_lines.lua:326
msgid "Welcome back!"
msgstr "Que bom ver-te de volta!"

#: modules/critter/reaction_lines.lua:368
msgid "Welcome back, stranger!"
msgstr "Ora, uma cara conhecida!"

#: modules/critter/reaction_lines.lua:352
msgid "Welcome home."
msgstr "Estás em casa."

#: modules/critter/reaction_lines.lua:284
msgid "Welcome to %s!"
msgstr "Chegámos a %s!"

#: modules/critter/reaction_lines.lua:136
msgid "What a lovely session! Bravo!"
msgstr "Que sessão linda! Bravo!"

#: modules/critter/reaction_lines.lua:340
msgid "What did I miss?"
msgstr "O que é que perdi?"

#: modules/critter/dialog.lua:326
msgid "What do you do all day?"
msgstr "O que fazes o dia todo?"

#: modules/critter/dialog.lua:420
msgid "What if I miss a day?"
msgstr "E se faltar um dia?"

#: modules/critter/reaction_lines.lua:225
msgid "What shall we read first?"
msgstr "O que lemos primeiro?"

#: modules/critter/dialog.lua:291
msgid "What's a last page?"
msgstr "O que é uma última página?"

#: modules/critter/dialog.lua:45
msgid "Whenever you're ready. I'll be right here."
msgstr "Quando quiseres. Estou aqui."

#: modules/critter/dialog.lua:89
msgid "Where was I? Ah, yes: snacks."
msgstr "Onde é que eu ia? Ah, sim: snacks."

#: modules/critter/dialog.lua:75
msgid "Whether I am a footnote or a whole chapter."
msgstr "Se sou uma nota de rodapé ou um capítulo inteiro."

#: modules/critter/dialog.lua:74
msgid "Whether anyone reads me. Never mind."
msgstr "Se alguém me lê. Esquece."

#: modules/critter/dialog.lua:70
msgid "Whether books read us back."
msgstr "Se os livros nos leem de volta."

#: modules/critter/dialog.lua:501
msgid "Which book next?"
msgstr "Qual é o livro a seguir?"

#: modules/critter/dialog.lua:238
msgid "Wise. Spoken like a scholar."
msgstr "Sábio conselho. Falas como quem sabe."

#: modules/critter/dialog.lua:269
msgid "Wonderful! Suspense is the best part!"
msgstr "Maravilhoso! O suspense é o melhor!"

#: modules/critter/reaction_lines.lua:248
msgid "World Book Day. Fine. Read something."
msgstr "Dia Mundial do Livro. Pronto. Lê alguma coisa."

#: modules/critter/dialog.lua:158
msgid "Wow! Page 212! You're amazing!"
msgstr "Uau! Página 212! És incrível!"

#: modules/critter/dialog.lua:246
msgid "YES! The best kind of book!"
msgstr "SIM! O melhor tipo de livro!"

#: modules/critter/reaction_lines.lua:358
msgid "YOU'RE BACK! Confetti, everyone!"
msgstr "VOLTASTE! Confetis para todos!"

#: modules/critter/dialog.lua:398
msgid "Yes yes yes! Let's gooo!"
msgstr "Sim sim sim! Vamos láaa!"

#: modules/critter/dialog.lua:314
msgid "Yes! We agree! What a lovely day!"
msgstr "Sim! Estamos de acordo! Que dia lindo!"

#: modules/critter/dialog.lua:585
msgid "Yes! You've got this!"
msgstr "Sim! Tu consegues!"

#: modules/critter/dialog.lua:555
msgid "Yes, pick one"
msgstr "Sim, escolhe um"

#: modules/critter/reaction_lines.lua:354
msgid "You came back."
msgstr "Voltaste."

#: modules/critter/dialog.lua:620
msgid "You can do it! One page at a time!"
msgstr "Consegues! Uma página de cada vez!"

#: modules/critter/reaction_lines.lua:63
msgid "You finished %s."
msgstr "Acabaste %s."

#: modules/critter/reaction_lines.lua:85
msgid "You finished a book."
msgstr "Acabaste um livro."

#: modules/critter/reaction_lines.lua:274
msgid "You had a book in your hand."
msgstr "Tinhas um livro na mão."

#: modules/critter/dialog.lua:117
msgid "You know the one."
msgstr "Sabes qual é."

#: modules/critter/reaction_lines.lua:168
msgid "You must tell me everything."
msgstr "Tens de me contar tudo."

#: modules/critter/reaction_lines.lua:206
msgid "You plugged me in."
msgstr "Ligaste-me à corrente."

#: modules/critter/reaction_lines.lua:414
msgid "You said you would, and you did."
msgstr "Disseste que ias fazer, e fizeste."

#: modules/critter/dialog.lua:543
msgid "You understand me, %s. Truly."
msgstr "Tu percebes-me, %s. A sério."

#: modules/critter/reaction_lines.lua:337
msgid "You're back! Best day ever!"
msgstr "Voltaste! O melhor dia de sempre!"

#: modules/critter/reaction_lines.lua:316
msgid "You're back! I missed you!"
msgstr "Voltaste! Tive saudades tuas!"

#: modules/critter/reaction_lines.lua:343
msgid "You're back. Finally. I got so bored I napped."
msgstr "Voltaste. Finalmente. Aborreci-me tanto que adormeci."

#: modules/critter/reaction_lines.lua:364
msgid "You're back. I slept through half of it."
msgstr "Voltaste. Dormi metade do tempo."

#: modules/critter/reaction_lines.lua:322
msgid "You're back. I was napping, honest."
msgstr "Voltaste. Estava a dormir a sesta, a sério."

#: modules/critter/reaction_lines.lua:207
msgid "You're my favourite human."
msgstr "És a minha pessoa preferida."

#: modules/critter/dialog.lua:563
msgid "You've opened them all. I'm so proud."
msgstr "Abriste-os todos. Estou tão orgulhoso."

#: modules/critter/dialog.lua:147
msgid "Yours! Take it! Take two!"
msgstr "Teu! Leva! Leva dois!"

#: modules/critter/dialog.lua:410
msgid "Zero pressure, infinite splendour."
msgstr "Zero pressão, esplendor infinito."

#: modules/critter/dialog.lua:407
msgid "Zero pressure. Pure vibes."
msgstr "Zero pressão. Só boas vibrações."

#: modules/critter/dialog.lua:409
msgid "Zero. None. Breathe."
msgstr "Zero. Nenhum. Respira."

#: modules/critter/dialog.lua:470
msgid "%d book this year. The goal is watching."
msgid_plural "%d books this year. The goal is watching."
msgstr[0] "%d livro este ano. O objetivo está a observar."
msgstr[1] "%d livros este ano. O objetivo está a observar."

#: modules/critter/reaction_lines.lua:310
msgid "%d day away. I counted."
msgid_plural "%d days away. I counted."
msgstr[0] "%d dia fora. Eu contei."
msgstr[1] "%d dias fora. Eu contei."

#: modules/critter/reaction_lines.lua:351
msgid "%d day! I thought you'd moved."
msgid_plural "%d days! I thought you'd moved."
msgstr[0] "%d dia! Pensei que te tinhas mudado."
msgstr[1] "%d dias! Pensei que te tinhas mudado."

#: modules/critter/reaction_lines.lua:330
msgid "%d day! Where were you?"
msgid_plural "%d days! Where were you?"
msgstr[0] "%d dia! Onde andavas?"
msgstr[1] "%d dias! Onde andavas?"

#: modules/critter/reaction_lines.lua:129
msgid "%d minute of reading."
msgid_plural "%d minutes of reading."
msgstr[0] "%d minuto de leitura."
msgstr[1] "%d minutos de leitura."

#: modules/critter/reaction_lines.lua:154
msgid "%d minute without surfacing."
msgid_plural "%d minutes without surfacing."
msgstr[0] "%d minuto sem vir à tona."
msgstr[1] "%d minutos sem vir à tona."

#: modules/critter/reaction_lines.lua:150
msgid "%d minute! Did you eat?"
msgid_plural "%d minutes! Did you eat?"
msgstr[0] "%d minuto! Comeste alguma coisa?"
msgstr[1] "%d minutos! Comeste alguma coisa?"

#: modules/critter/reaction_lines.lua:109
msgid "%d minute. A sneaky one."
msgid_plural "%d minutes. A sneaky one."
msgstr[0] "%d minuto. Um escondidinho."
msgstr[1] "%d minutos. Um escondidinho."

#: modules/critter/challenge.lua:213
msgid "%d of %d minute so far."
msgid_plural "%d of %d minutes so far."
msgstr[0] "%d de %d minuto até agora."
msgstr[1] "%d de %d minutos até agora."

#: modules/critter/challenge.lua:216
msgid "%d of %d page so far."
msgid_plural "%d of %d pages so far."
msgstr[0] "%d de %d página até agora."
msgstr[1] "%d de %d páginas até agora."

#: modules/critter/reaction_lines.lua:267
msgid "%d year of pages and snacks."
msgid_plural "%d years of pages and snacks."
msgstr[0] "%d ano de páginas e snacks."
msgstr[1] "%d anos de páginas e snacks."

#: modules/critter/reaction_lines.lua:263
msgid "%d year together!"
msgid_plural "%d years together!"
msgstr[0] "%d ano juntos!"
msgstr[1] "%d anos juntos!"

#: modules/critter/dialog.lua:388
msgid "Our streak is at %d day. No pressure."
msgid_plural "Our streak is at %d days. No pressure."
msgstr[0] "A nossa sequência está em %d dia. Sem pressão."
msgstr[1] "A nossa sequência está em %d dias. Sem pressão."

#: modules/critter/challenge.lua:201
msgid "Read %d minute today?"
msgid_plural "Read %d minutes today?"
msgstr[0] "Ler %d minuto hoje?"
msgstr[1] "Ler %d minutos hoje?"

#: modules/critter/challenge.lua:203
msgid "Read %d page today?"
msgid_plural "Read %d pages today?"
msgstr[0] "Ler %d página hoje?"
msgstr[1] "Ler %d páginas hoje?"
